# Copy to .env and adjust. Node loads it automatically via --env-file-if-exists.
PORT=4000
# Leave DATABASE_URL unset to use the built-in database (nothing to install).
# To use your own PostgreSQL server instead, uncomment:
# DATABASE_URL=postgres://safezone:safezone_dev@localhost:5432/safezone
FRONTEND_ORIGIN=http://localhost:5173

# REQUIRED in production (the app refuses to start with defaults):
# JWT_SECRET=<at least 32 random characters>
# REPORT_ENCRYPTION_KEY=<64 hex characters, for example: openssl rand -hex 32>

# Guardians must be verified by an administrator before connecting to a child
REQUIRE_GUARDIAN_VERIFICATION=false

# Geofence validation
GEOFENCE_MAX_ACCURACY_M=100
GEOFENCE_CONFIRM_READINGS=2
GEOFENCE_CONFIRM_MIN_SECONDS=15
GEOFENCE_COOLDOWN_SECONDS=300

# Retention (days)
RETENTION_LOCATION_EVENTS_DAYS=30
RETENTION_SOS_DAYS=90
RETENTION_NOTIFICATIONS_DAYS=90
