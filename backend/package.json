{
  "name": "safezone-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SafeZone API: privacy-preserving geofencing and emergency alerts",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
